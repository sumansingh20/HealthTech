{
  "name": "@icu/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./mongo": {
      "types": "./src/mongo.ts",
      "import": "./dist/mongo.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "echo 'shared package lint not configured'",
    "test": "echo 'shared package tests handled at workspace level'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@icu/config": "workspace:^",
    "mongodb": "^5.9.2",
    "zod": "^3.24.1"
  }
}

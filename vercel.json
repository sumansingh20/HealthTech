{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "corepack enable && pnpm --filter @icu/shared build && pnpm --filter web build",
  "installCommand": "corepack enable && pnpm install --frozen-lockfile",
  "devCommand": "corepack enable && pnpm --filter web dev",
  "outputDirectory": "apps/web/.next",
  "regions": [
    "iad1"
  ],
  "github": {
    "enabled": true,
    "autoJobCancelation": true
  },
  "experimentalServices": {
    "web": {
      "entrypoint": "apps/web",
      "routePrefix": "/",
      "framework": "nextjs"
    },
    "ml": {
      "entrypoint": "services/ml",
      "routePrefix": "/_/ml"
    }
  }
}

FROM node:22-alpine AS deps
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps/web/package.json ./apps/web/package.json
COPY services/api-gateway/package.json ./services/api-gateway/package.json
COPY services/auth/package.json ./services/auth/package.json
COPY services/patient/package.json ./services/patient/package.json
COPY services/vitals/package.json ./services/vitals/package.json
COPY services/iot/package.json ./services/iot/package.json
COPY services/notifications/package.json ./services/notifications/package.json
COPY services/analytics/package.json ./services/analytics/package.json
COPY services/audit/package.json ./services/audit/package.json
RUN pnpm install --no-frozen-lockfile

FROM deps AS build
ARG SERVICE
COPY . .
RUN pnpm --filter @icu/shared build
RUN pnpm --filter ${SERVICE} build

FROM node:22-alpine AS runtime
WORKDIR /app
RUN corepack enable
ARG SERVICE
ENV SERVICE=${SERVICE}
ENV NODE_ENV=production
COPY --from=build /app /app
EXPOSE 3000 4000 4001 4002 4003 4005 4006 4007 4008
CMD pnpm --filter ${SERVICE} start
